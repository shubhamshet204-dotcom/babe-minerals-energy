# API server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4321

# Create a Google OAuth 2.0 Web application client at https://console.cloud.google.com/apis/credentials
# Add the frontend origin (http://localhost:4321) to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# SMTP provider used to send account verification links.
# In local development, omit SMTP_HOST to print the verification link in the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BME Steels <no-reply@example.com>
