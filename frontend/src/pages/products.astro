---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import AddToCart from '../components/store/AddToCart.astro';
import { categories, categories30, navGroups, brands, allProducts } from '../data/catalog';
---

<Layout
  title="Industrial Catalog & Materials | BME Steels"
  description="Explore hot rolled steel, structural steel, TMT bars, cold rolled coils and industrial supplies across 30 categories at BME."
>
  <section class="bg-surface-soft py-20">
    <div class="container-bme">
      <div class="mb-8 max-w-2xl">
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-primary">Steel products</p>
        <h1 class="mt-2 text-4xl font-black tracking-tight text-ink">Materials built for industrial growth</h1>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {categories.slice(0, 8).map((category) => (
          <a
            href={category.slug === 'steel' ? '/category/steel' : category.slug === 'hot-rolled-steel' ? '/category/mild-steel/hot-rolled-steel' : `/category/${category.slug}`}
            class="overflow-hidden rounded-none border border-hairline bg-canvas transition-colors hover:border-ink"
          >
            <img src={category.image} alt={category.imageAlt} loading="lazy" class="h-36 w-full object-cover" />
            <div class="p-5">
            <h2 class="text-xl font-bold text-ink">{category.title}</h2>
            <p class="mt-3 text-sm leading-6 text-muted">{category.description}</p>
            <div class="mt-4 flex items-center justify-between border-t border-hairline pt-4">
              <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">{category.spec}</span>
              <span class="text-sm font-bold text-ink">{category.tag}</span>
            </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-soft py-20">
    <div class="container-bme">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-primary">Catalog items</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-ink">Browse All Materials & Specifications</h2>
        </div>
      </div>

      <form id="catalog-filters" class="mb-8 grid gap-3 rounded-none border border-hairline bg-canvas p-4 sm:grid-cols-[1fr_220px_220px]">
        <label class="sr-only" for="catalog-search">Search products</label>
        <input id="catalog-search" type="search" placeholder="Search products, grades or sizes" class="h-11 rounded-none border border-hairline bg-canvas px-3 text-sm text-ink outline-none focus:border-ink" />
        <label class="sr-only" for="brand-filter">Filter by brand</label>
        <select id="brand-filter" class="h-11 rounded-none border border-hairline bg-canvas px-3 text-sm text-ink outline-none focus:border-ink">
          <option value="">All brands</option>
          {brands.map((brand) => <option value={brand.slug}>{brand.name}</option>)}
        </select>
        <label class="sr-only" for="category-filter">Filter by category</label>
        <select id="category-filter" class="h-11 rounded-none border border-hairline bg-canvas px-3 text-sm text-ink outline-none focus:border-ink">
          <option value="">All categories (30 Groups)</option>
          {navGroups.map((group) => {
            const groupCats = categories30.filter((c) => group.categorySlugs.includes(c.slug));
            return (
              <optgroup label={group.title}>
                {groupCats.map((cat) => (
                  <option value={cat.slug}>{cat.title}</option>
                ))}
              </optgroup>
            );
          })}
        </select>
      </form>
      <p id="catalog-result-count" class="mb-4 text-sm text-muted" aria-live="polite"></p>

      <div class="grid gap-6 lg:grid-cols-2">
        {allProducts.map((product) => {
          const prodGroup = navGroups.find((g) => g.categorySlugs.includes(product.categorySlug) || (product.categorySlug.includes('steel') && g.slug === 'steel-and-metals') || (product.categorySlug === 'tmt-bars' && g.slug === 'steel-and-metals') || (product.categorySlug === 'wire-rods' && g.slug === 'steel-and-metals') || (product.categorySlug === 'cement' && g.slug === 'construction-and-industrial'));
          return (
            <article data-product-card data-search={`${product.name} ${product.brand} ${product.size} ${product.grade}`} data-brand={product.brandSlug} data-category={product.categorySlug} data-group={prodGroup ? prodGroup.slug : ''} class="overflow-hidden rounded-none border border-hairline bg-canvas">
              <img src={product.image} alt={product.imageAlt} loading="lazy" class="h-52 w-full object-cover" />
              <div class="p-5">
              <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                  <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">{product.batch}</p>
                  <h3 class="mt-2 text-2xl font-bold text-ink"><a href={`/product/${product.id}`} class="hover:underline">{product.name}</a></h3>
                  <p class="mt-1 text-sm text-muted">{product.brand}</p>
                </div>
                <span class="rounded-xs bg-primary/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-primary">{product.grade}</span>
              </div>

              <div class="mt-5 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
                <div>
                  <p class="text-sm font-medium text-muted">Available sizes</p>
                  <p class="mt-2 text-xl font-black text-ink">{product.size}</p>
                  <p class="mt-3 text-sm leading-6 text-muted">{product.description}</p>
                </div>
                <div class="text-left md:text-right">
                  <p class="text-[10px] uppercase tracking-[0.12em] text-muted">Starting at</p>
                  <p class="mt-2 text-2xl font-black text-ink">{product.price}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <AddToCart product={product} />
                    <Button variant="outline" size="sm" href="/quote">Request pricing</Button>
                  </div>
                </div>
              </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <script>
    const filters = document.getElementById('catalog-filters');
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const brandSelect = document.getElementById('brand-filter') as HTMLSelectElement | null;
    const categorySelect = document.getElementById('category-filter') as HTMLSelectElement | null;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-product-card]')];
    const resultCount = document.getElementById('catalog-result-count');

    if (filters && searchInput && brandSelect && categorySelect && resultCount) {
      const params = new URLSearchParams(window.location.search);
      searchInput.value = params.get('q') || '';
      brandSelect.value = params.get('brand') || '';
      categorySelect.value = params.get('category') || '';
      const groupParam = params.get('group') || '';

      const applyFilters = () => {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;
        for (const card of cards) {
          const matches = (card.dataset.search || '').toLowerCase().includes(query)
            && (!brandSelect.value || card.dataset.brand === brandSelect.value)
            && (!categorySelect.value || card.dataset.category === categorySelect.value)
            && (!groupParam || categorySelect.value || card.dataset.group === groupParam);
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        }
        resultCount.textContent = `${visibleCount} product${visibleCount === 1 ? '' : 's'} found`;
      };

      filters.addEventListener('input', applyFilters);
      filters.addEventListener('change', applyFilters);
      applyFilters();
    }
  </script>
</Layout>
