---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Image Credits | BME Steels" description="Sources and reuse licenses for photography used on BME Steels.">
  <section class="bg-surface-soft py-14 lg:py-20">
    <div class="container-bme">
      <header class="mb-10 max-w-3xl">
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-primary">Photography</p>
        <h1 class="mt-2 text-4xl font-black tracking-tight text-ink">Image credits</h1>
        <p class="mt-4 text-base leading-7 text-muted">Brand names are shown as text identifiers. Product and category photos are illustrative, not official brand product photography.</p>
      </header>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="border border-hairline bg-canvas p-5">
          <img src="/images/steel-coils.jpg" alt="Steel coils stored inside a warehouse" class="mb-4 h-48 w-full object-cover" />
          <h2 class="text-lg font-bold text-ink">Factory steel coil inventory</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Photographer: Shandong Mingtong Metal Manufacturing. Wikimedia Commons. Creative Commons Attribution-ShareAlike 4.0.</p>
          <a href="https://commons.wikimedia.org/wiki/File:Factory_steel_coil_inventory.jpg" target="_blank" rel="noreferrer" class="mt-3 inline-block text-sm font-semibold text-ink underline underline-offset-4">Source and license</a>
        </article>

        <article class="border border-hairline bg-canvas p-5">
          <img src="/images/rebar.jpg" alt="Close-up of ribbed reinforcing steel bars" class="mb-4 h-48 w-full object-cover" />
          <h2 class="text-lg font-bold text-ink">A bunch of rebar up close</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Photographer: W.carter. Wikimedia Commons. Creative Commons Attribution-ShareAlike 4.0.</p>
          <a href="https://commons.wikimedia.org/wiki/File:A_bunch_of_rebar_up_close.jpg" target="_blank" rel="noreferrer" class="mt-3 inline-block text-sm font-semibold text-ink underline underline-offset-4">Source and license</a>
        </article>

        <article class="border border-hairline bg-canvas p-5">
          <img src="/images/cement-plant.jpg" alt="Cement production plant" class="mb-4 h-48 w-full object-cover" />
          <h2 class="text-lg font-bold text-ink">Cement production line</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Photographer: HandaKiln. Wikimedia Commons. Creative Commons Attribution-ShareAlike 4.0.</p>
          <a href="https://commons.wikimedia.org/wiki/File:Cement-plant.jpg" target="_blank" rel="noreferrer" class="mt-3 inline-block text-sm font-semibold text-ink underline underline-offset-4">Source and license</a>
        </article>

      </div>
    </div>
  </section>
</Layout>
