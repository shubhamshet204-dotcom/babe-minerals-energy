  {
    slug: 'steel',
    title: 'Steel',
    image: '/images/categories/MS hot rolled.png',
    products: [
      { name: 'Carbon Steel Plates & Bars IS 2062', brand: 'Tata Steel', image: '/images/hot rolled sheets.png', href: '/product/carbon-steel' },
      { name: 'Alloy Steel Rounds EN19 / EN24', brand: 'JSW Steel', image: '/images/steel-coils.jpg', href: '/product/alloy-steel' },
      { name: 'Stainless Steel Sheets SS 304/316L', brand: 'Jindal Steel', image: '/images/hot rolled sheets.png', href: '/product/stainless-steel' },
