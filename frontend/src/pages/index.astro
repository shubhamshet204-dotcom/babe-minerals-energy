  <!-- How It Works (4 Steps) -->
  <section class="bg-surface-soft/40 py-12 border-b border-gray-100">
    <div class="container-bme">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink">How to Order on BME</h2>
        <p class="text-xs text-muted mt-1">Simple, transparent procurement from specification to dispatch</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {processSteps.map((step) => (
          <div class="rounded-xl border border-gray-200 bg-white p-5">
