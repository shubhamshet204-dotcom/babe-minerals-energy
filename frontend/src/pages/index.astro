---
import Layout from '../layouts/Layout.astro';
import AddToCart from '../components/store/AddToCart.astro';
import Icon from '../components/ui/Icon.astro';

import { categories, brands, topProducts, industries, trustPoints, processSteps, faqList } from '../data/catalog';

// Category product rows – JSW One style
const getCategoryHref = (slug: string) => {
  if (slug === 'steel') return '/category/steel';
  if (slug === 'hot-rolled-steel') return '/category/mild-steel/hot-rolled-steel';
  return `/products?category=${slug}`;
};

