      { name: 'AMNS Cold Rolled Sheets CR2', brand: 'AM/NS India', image: '/images/categories/ms cold rolled.png' },
      { name: 'JSW Cold Rolled Coils CR4', brand: 'JSW Steel', image: '/images/categories/ms cold rolled.png' },
      { name: 'Cold Rolled Sheets IS 513 CR2', brand: 'SAIL', image: '/images/categories/ms cold rolled.png' },
      { name: 'CRCA Sheets IS 513 CR4', brand: 'Tata Steel', image: '/images/categories/ms cold rolled.png' },
    ],
  },
  {
    slug: 'tmt-bars',
