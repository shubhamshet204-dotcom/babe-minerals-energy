      { name: 'MS Square / Round Bars', brand: 'JSW Steel', image: '/images/categories/structural steel.png' },
    ],
  },
  {
    slug: 'coated-steel',
    title: 'Coated Steel',
    image: '/images/categories/coated steel.png',
    products: [
      { name: 'Pre-Painted GI Roofing (PPGI)', brand: 'Tata Steel', image: '/images/categories/coated steel.png' },
      { name: 'Galvanized Plain Sheets (GP)', brand: 'JSW Steel', image: '/images/categories/coated steel.png' },
      { name: 'Colour Coated Profile Sheets', brand: 'AM/NS India', image: '/images/categories/coated steel.png' },
      { name: 'GI Corrugated Roofing Sheets', brand: 'SAIL', image: '/images/categories/coated steel.png' },
      { name: 'Aluzinc Coated Sheets', brand: 'Tata Steel', image: '/images/categories/coated steel.png' },
    ],
  },
  {
    slug: 'wire-rods',
    title: 'Wire Rods',
    image: '/images/categories/wire rods.png',
    products: [
      { name: 'MS Wire Rods IS 7887 GrI', brand: 'JSW Steel', image: '/images/categories/wire rods.png' },
      { name: 'High Carbon Wire Rods', brand: 'SAIL', image: '/images/categories/wire rods.png' },
      { name: 'Low Carbon Wire Rods', brand: 'Tata Steel', image: '/images/categories/wire rods.png' },
      { name: 'Wire Rod Coils for Fasteners', brand: 'Jindal Steel', image: '/images/categories/wire rods.png' },
