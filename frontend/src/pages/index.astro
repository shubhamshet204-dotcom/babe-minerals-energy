      { name: 'JSW Steel Hot Rolled Coils IS 2062:2011 E250A', brand: 'JSW Steel', image: '/images/categories/MS hot rolled.png', href: '/category/mild-steel/hot-rolled-steel' },
    ],
  },
  {
    slug: 'cold-rolled-steel',
    title: 'MS Cold Rolled',
    image: '/images/categories/ms cold rolled.png',
