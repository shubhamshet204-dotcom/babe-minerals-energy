---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout
  title="Request a Steel Quote | BME Steels"
  description="Request pricing and procurement support for steel materials, TMT bars, HR sheet, CR coil and structural sections."
>
  <section class="bg-[#f5f5f5] py-20">
    <div class="container-bme">
      <div class="mx-auto max-w-5xl overflow-hidden rounded-md border border-hairline bg-canvas shadow-[0_20px_60px_rgba(0,0,0,0.05)]">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
          <div class="bg-[#111111] p-8 text-white">
            <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-primary">Request a quote</p>
            <h1 class="mt-3 text-4xl font-black tracking-[-0.05em] text-white">Get material pricing in minutes</h1>
            <p class="mt-4 text-base leading-7 text-white/75">
              Share your requirement and we will get back with the right grade, quantity suggestion, and dispatch support.
            </p>

            <div class="mt-8 space-y-3 text-sm text-white/70">
              <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <span>Typical callback</span>
                <span class="font-bold text-white">Within 30 min</span>
              </div>
              <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <span>Support desk</span>
                <span class="font-bold text-white">Procurement team</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Minimum order</span>
                <span class="font-bold text-white">5 MT</span>
              </div>
            </div>
          </div>

          <div class="p-8">
            <form id="quote-form" class="space-y-5">
              <div class="grid gap-5 md:grid-cols-2">
                <label class="block text-sm font-medium text-ink">
                  Full name
                  <input name="name" type="text" required class="mt-2 block w-full rounded-xl border border-hairline bg-neutral-1 px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="Your name" />
                </label>
                <label class="block text-sm font-medium text-ink">
                  Business email
                  <input name="email" type="email" required class="mt-2 block w-full rounded-xl border border-hairline bg-neutral-1 px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="you@company.com" />
                </label>
              </div>

              <div class="grid gap-5 md:grid-cols-2">
                <label class="block text-sm font-medium text-ink">
                  Phone number
                  <input name="phone" type="tel" class="mt-2 block w-full rounded-xl border border-hairline bg-neutral-1 px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="+91 98xxxxxx" />
                </label>
                <label class="block text-sm font-medium text-ink">
                  Company name
                  <input name="company" type="text" required class="mt-2 block w-full rounded-xl border border-hairline bg-neutral-1 px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="Your company" />
                </label>
              </div>

              <input type="hidden" name="deliveryLocation" data-delivery-location-field />

              <label class="block text-sm font-medium text-ink">
                Requirement details
                <textarea name="requirement" rows="5" required class="mt-2 block w-full rounded-xl border border-hairline bg-neutral-1 px-4 py-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" placeholder="Tell us the steel grade, quantity, required dispatch date and project location."></textarea>
              </label>

              <div class="flex flex-wrap items-center gap-3 pt-2">
                <Button variant="primary" type="submit" size="lg">Submit requirement</Button>
                <Button variant="outline" href="/contact" size="lg">Talk to sales</Button>
              </div>

              <p id="quote-status" class="min-h-[24px] text-sm text-muted"></p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';
    const form = document.getElementById('quote-form') as HTMLFormElement | null;
    const status = document.getElementById('quote-status');

    if (form && status) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        status.textContent = 'Submitting your requirement...';
        status.className = 'min-h-[24px] text-sm text-muted';

        try {
          const response = await fetch(`${apiBase}/api/quote`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'Something went wrong.');
          }

          status.textContent = 'Your request has been submitted successfully. Our team will contact you shortly.';
          status.className = 'min-h-[24px] text-sm text-green-600';
          form.reset();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Unable to submit your requirement right now.';
          status.className = 'min-h-[24px] text-sm text-red-600';
        }
      });
    }
  </script>
</Layout>
