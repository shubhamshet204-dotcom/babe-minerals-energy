---
import type { HTMLAttributes } from 'astro/types';

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props extends HTMLAttributes<'select'> {
  label?: string;
  helperText?: string;
  error?: string;
  options?: Option[];
  placeholder?: string;
  id?: string;
  class?: string;
}

const {
  label,
  helperText,
  error,
  options = [],
  placeholder,
  id,
  class: className = '',
  disabled = false,
  required = false,
  ...rest
} = Astro.props;

const selectId = id || (label ? label.toLowerCase().replace(/\s+/g, '-') : undefined);
---

<div class={`w-full flex flex-col gap-1.5 ${className}`}>
  {
    label && (
      <label
        for={selectId}
        class="text-[14px] font-semibold text-ink flex items-center justify-between"
      >
        <span>
          {label}
          {required && <span class="text-accent-4 ml-0.5">*</span>}
        </span>
      </label>
    )
  }

  <div class="relative flex items-center w-full">
    <select
      id={selectId}
      disabled={disabled}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={
        error ? `${selectId}-error` : helperText ? `${selectId}-helper` : undefined
      }
      class={`
        w-full appearance-none bg-canvas text-body font-sans text-[16px] leading-[1.5]
        border transition-colors duration-150 outline-none
        h-[40px] rounded-sm pl-3.5 pr-10 py-2 cursor-pointer
        ${
          error
            ? 'border-accent-4 focus:border-accent-4 focus:ring-2 focus:ring-accent-4/20'
            : 'border-hairline hover:border-[#BDBDBD] focus:border-primary focus:ring-2 focus:ring-primary/20'
        }
        disabled:opacity-70 disabled:bg-neutral-1 disabled:cursor-not-allowed
      `}
      {...rest}
    >
      {placeholder && (
        <option value="" disabled selected={!rest.value}>
          {placeholder}
        </option>
      )}
      {options.map((opt) => (
        <option value={opt.value} disabled={opt.disabled}>
          {opt.label}
        </option>
      ))}
      <slot />
    </select>

    <div class="absolute right-3.5 pointer-events-none text-muted flex items-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </div>
  </div>

  {
    error ? (
      <p id={`${selectId}-error`} class="text-[12px] font-medium text-accent-4 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" x2="12" y1="8" y2="12" />
          <line x1="12" x2="12.01" y1="16" y2="16" />
        </svg>
        <span>{error}</span>
      </p>
    ) : helperText ? (
      <p id={`${selectId}-helper`} class="text-[12px] text-muted">
        {helperText}
      </p>
    ) : null
  }
</div>
