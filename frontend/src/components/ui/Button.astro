---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'outline-light' | 'text' | 'icon' | 'icon-sm';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  disabled?: boolean;
  fullWidth?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  disabled = false,
  fullWidth = false,
  class: className = '',
  type = 'button',
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

// Base styles common to buttons
const baseStyles =
  'inline-flex items-center justify-center font-sans font-bold transition-all duration-200 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';

// Variant styles strictly adhering to DESIGN.md
const variantStyles: Record<string, string> = {
  primary:
    'bg-primary text-ink hover:bg-primary-deep active:bg-primary-deep border border-transparent disabled:opacity-70 disabled:cursor-not-allowed disabled:pointer-events-none',
  secondary:
    'bg-surface-soft text-ink hover:bg-[#ececec] border border-hairline disabled:opacity-70 disabled:cursor-not-allowed',
  outline:
    'bg-transparent text-ink border border-hairline hover:bg-primary/10 hover:border-ink font-semibold disabled:opacity-70 disabled:cursor-not-allowed',
  'outline-light':
    'bg-transparent text-on-dark border border-white/60 hover:bg-white/10 hover:border-white font-semibold disabled:opacity-70 disabled:cursor-not-allowed',
  text:
    'bg-transparent text-body hover:text-ink font-medium p-0 h-auto rounded-none disabled:opacity-70 disabled:cursor-not-allowed',
  icon:
    'bg-canvas text-ink border border-hairline rounded-full shadow-sm hover:bg-surface-soft hover:border-ink disabled:opacity-70 disabled:cursor-not-allowed p-0 aspect-square shrink-0',
  'icon-sm':
    'bg-canvas text-ink border border-hairline rounded-full shadow-sm hover:bg-surface-soft hover:border-ink disabled:opacity-70 disabled:cursor-not-allowed p-0 aspect-square shrink-0',
};

// Size styles adhering to DESIGN.md
const sizeStyles: Record<string, string> = {
  sm: 'text-[14px] leading-[1.43] font-semibold h-[32px] px-3 rounded-md',
  md: 'text-[16px] leading-[1.5] font-bold h-[40px] px-5 rounded-md',
  lg: 'text-[16px] leading-[1.5] font-bold h-[48px] px-6 rounded-md',
};

// Specific size overrides for icon variants
const iconSizeStyles: Record<string, string> = {
  icon: 'w-[36px] h-[36px]',
  'icon-sm': 'w-[32px] h-[32px]',
};

let resolvedClass = `${baseStyles} ${variantStyles[variant] || variantStyles.primary}`;

if (variant === 'icon' || variant === 'icon-sm') {
  resolvedClass += ` ${iconSizeStyles[variant]}`;
} else if (variant !== 'text') {
  resolvedClass += ` ${sizeStyles[size] || sizeStyles.md}`;
}

if (fullWidth) {
  resolvedClass += ' w-full';
}

if (className) {
  resolvedClass += ` ${className}`;
}
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      target={target}
      class={resolvedClass}
      aria-disabled={disabled ? 'true' : undefined}
      aria-label={ariaLabel}
      tabindex={disabled ? -1 : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={resolvedClass}
      disabled={disabled}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </button>
  )
}
