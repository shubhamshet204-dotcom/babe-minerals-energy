---
interface Props {
  variant?: 'default' | 'category' | 'elevated' | 'featured';
  hoverable?: boolean;
  class?: string;
  as?: 'div' | 'article' | 'section' | 'a';
  href?: string;
}

const {
  variant = 'default',
  hoverable = false,
  class: className = '',
  as: Component = 'div',
  href,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : Component;

// Variants strictly adhering to DESIGN.md
const variantClasses: Record<string, string> = {
  default: 'bg-canvas border border-hairline rounded-lg p-4 text-body',
  category: 'bg-surface-soft border border-hairline rounded-md p-4 text-body hover:bg-[#f1f1f1]',
  elevated: 'bg-canvas border border-hairline rounded-lg p-4 shadow-sm text-body',
  featured: 'bg-canvas border border-hairline rounded-lg p-6 shadow-md text-body',
};

const hoverClass =
  hoverable || href
    ? 'transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm cursor-pointer'
    : '';
---

<Tag
  href={href}
  class={`block ${variantClasses[variant] || variantClasses.default} ${hoverClass} ${className}`}
  {...rest}
>
  <slot />
</Tag>
