---
interface Props {
  class?: string;
  variant?: 'text' | 'rectangular' | 'circular';
  width?: string;
  height?: string;
}

const {
  class: className = '',
  variant = 'rectangular',
  width,
  height,
} = Astro.props;

const variantClasses: Record<string, string> = {
  text: 'h-4 w-full rounded-xs',
  rectangular: 'rounded-md',
  circular: 'rounded-full aspect-square',
};

const style = [
  width ? `width: ${width}` : '',
  height ? `height: ${height}` : '',
]
  .filter(Boolean)
  .join('; ');
---

<div
  class={`bg-neutral-1 animate-pulse border border-hairline/50 ${variantClasses[variant]} ${className}`}
  style={style}
  aria-hidden="true"
>
</div>
