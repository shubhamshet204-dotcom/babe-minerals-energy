---
import Icon from './Icon.astro';

interface Props {
  icon?:
    | 'box'
    | 'search'
    | 'file-text'
    | 'layers'
    | 'filter';
  title: string;
  description: string;
  class?: string;
}

const {
  icon = 'box',
  title,
  description,
  class: className = '',
} = Astro.props;
---

<div
  class={`flex flex-col items-center justify-center text-center p-8 sm:p-12 border border-dashed border-hairline rounded-none bg-surface-soft ${className}`}
>
  <div
    class="w-14 h-14 rounded-full bg-canvas border border-hairline flex items-center justify-center text-ash mb-4"
  >
    <Icon name={icon} size={28} />
  </div>

  <h3 class="text-[18px] font-semibold text-ink leading-[1.33] max-w-md">
    {title}
  </h3>

  <p class="text-[14px] text-ash leading-[1.45] max-w-sm mt-1.5 mb-6">
    {description}
  </p>

  {
    Astro.slots.has('default') && (
      <div class="flex items-center gap-3 flex-wrap justify-center">
        <slot />
      </div>
    )
  }
</div>
