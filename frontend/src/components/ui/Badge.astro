---
interface Props {
  variant?: 'primary' | 'neutral' | 'dark' | 'accent' | 'error' | 'success';
  shape?: 'rounded' | 'pill';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'neutral',
  shape = 'rounded',
  size = 'md',
  class: className = '',
} = Astro.props;

const variantClasses: Record<string, string> = {
  primary: 'bg-primary text-ink border-transparent',
  neutral: 'bg-surface-soft text-muted border-hairline',
  dark: 'bg-ink text-on-dark border-transparent',
  accent: 'bg-primary/10 text-ink border-primary/30',
  error: 'bg-error/10 text-error border-error/30',
  success: 'bg-success/10 text-success border-success/30',
};

const shapeClasses: Record<string, string> = {
  rounded: 'rounded-xs',
  pill: 'rounded-full',
};

const sizeClasses: Record<string, string> = {
  sm: 'px-1.5 py-0.5 text-[11px] leading-[1.2]',
  md: 'px-2.5 py-1 text-[12px] leading-[1.33] tracking-[0.3px]',
};
---

<span
  class={`inline-flex items-center gap-1 font-sans font-semibold border ${variantClasses[variant]} ${shapeClasses[shape]} ${sizeClasses[size]} ${className}`}
>
  <slot />
</span>
