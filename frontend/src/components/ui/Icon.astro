---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  name:
    | 'search'
    | 'chevron-down'
    | 'chevron-right'
    | 'arrow-right'
    | 'check'
    | 'alert-circle'
    | 'alert-triangle'
    | 'info'
    | 'x'
    | 'menu'
    | 'file-text'
    | 'phone'
    | 'mail'
    | 'map-pin'
    | 'shield-check'
    | 'layers'
    | 'box'
    | 'refresh-cw'
    | 'external-link'
    | 'filter'
    | 'download'
    | 'chevron-left'
    | 'truck'
    | 'credit-card';
  class?: string;
  size?: number | string;
}

const { name, class: className = '', size = 20 } = Astro.props;
const dimension = typeof size === 'number' ? `${size}px` : size;
